# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Backend ---
OJP_API_KEY=
OJP_ENDPOINT=https://api.opentransportdata.swiss/ojp20
TOMTOM_API_KEY=
HERE_API_KEY=
# DATA_DIR=./Daten

# --- Frontend (Vite reads VITE_* from this file) ---
VITE_API_URL=http://localhost:8000
# Demo journey: demo-zh (Zürich HB -> Hinwil, simulated incident, default)
# or demo-1 (Lausanne -> Bern, real incident of 25.09.2026 replayed from Daten/)
# VITE_JOURNEY_ID=demo-zh

# --- Routing: live | record | replay (offline, recorded answers only) | auto ---
# auto = use the recordings, call OJP (and record) for anything new: best for the demo
OJP_MODE=auto
