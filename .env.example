# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Backend ---
OJP_API_KEY=
OJP_ENDPOINT=https://api.opentransportdata.swiss/ojp20
TOMTOM_API_KEY=
HERE_API_KEY=
# DATA_DIR=./Daten

# --- Frontend (Vite reads VITE_* from this file) ---
VITE_API_URL=http://localhost:8000
# true (default) = use the replayed demo scenario, false = call the backend
VITE_USE_MOCKS=true
